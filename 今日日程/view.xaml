<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="青序" Width="398" Height="600" WindowStyle="None" ResizeMode="CanResizeWithGrip" AllowsTransparency="True" ShowInTaskbar="True" ShowActivated="False" Topmost="False" Background="Transparent" FontFamily="Microsoft YaHei" FontSize="13" MinWidth="365" MinHeight="300">
 <Window.Resources>
  <Style TargetType="Button"><Setter Property="Foreground" Value="#658477"/><Setter Property="Background" Value="Transparent"/><Setter Property="Padding" Value="9,5"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" CornerRadius="7" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#EAF3ED"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="ToggleButton"><Setter Property="Foreground" Value="#88A094"/><Setter Property="Background" Value="Transparent"/><Setter Property="Padding" Value="13,7"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton"><Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter Property="Background" Value="#E6F2EB"/><Setter Property="Foreground" Value="#38755B"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter Property="Opacity" Value="0.8"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="CheckBox"><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Cursor" Value="Hand"/></Style>
  <Style TargetType="ScrollBar"><Setter Property="Width" Value="5"/><Setter Property="Background" Value="Transparent"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar"><Track Name="PART_Track" Width="4" HorizontalAlignment="Center" Orientation="Vertical" IsDirectionReversed="True" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value}" ViewportSize="{TemplateBinding ViewportSize}"><Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/></Track.DecreaseRepeatButton><Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="#D6E5DB" CornerRadius="3"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb><Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/></Track.IncreaseRepeatButton></Track></ControlTemplate></Setter.Value></Setter></Style>
 </Window.Resources>
 <Border Background="#FCFEFC" BorderBrush="#DCE9E1" BorderThickness="1" CornerRadius="18" Padding="20,17,20,15">
  <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid Name="Header" Background="Transparent" Cursor="SizeAll" ToolTip="按住标题区域拖动，可移动日程窗"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="32"/><ColumnDefinition Width="28"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="青序" FontSize="24" FontWeight="SemiBold" Foreground="#284C3B"/><TextBlock Name="DateLabel" FontSize="11" Foreground="#8AA195" Margin="0,5,0,0"/></StackPanel><ToggleButton Name="PinButton" Grid.Column="1" Content="📌" FontFamily="Segoe UI Emoji" FontSize="16" Padding="3" VerticalAlignment="Top" ToolTip="置顶窗口"/><Button Name="CloseButton" Grid.Column="2" Content="×" FontSize="19" Padding="3" VerticalAlignment="Top" ToolTip="关闭"/></Grid>
   <Grid Grid.Row="1" Margin="0,16,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition/><ColumnDefinition Width="28"/></Grid.ColumnDefinitions><Button Name="PrevButton" Content="‹" Padding="3" FontSize="20" ToolTip="前一天／前一周"/><StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center"><ToggleButton Name="TodayTab" Content="今天" Margin="1,0"/><ToggleButton Name="TomorrowTab" Content="10/20" Margin="1,0"/><ToggleButton Name="AfterTomorrowTab" Content="10/21" Margin="1,0"/><ToggleButton Name="WeekTab" Content="本周" Margin="1,0"/><Button Name="DatePickerButton" Content="选日期⌄" FontSize="11" Padding="6,5" Margin="3,0,0,0" ToolTip="选择日期查看和安排"/></StackPanel><Button Name="NextButton" Grid.Column="2" Content="›" Padding="3" FontSize="20" ToolTip="后一天／后一个周"/>
    <Popup Name="DatePopup" Placement="Bottom" PlacementTarget="{Binding ElementName=DatePickerButton}" StaysOpen="False" AllowsTransparency="True"><Border Background="#FCFEFC" BorderBrush="#DCE9E1" BorderThickness="1" CornerRadius="10" Padding="5"><Calendar Name="DateCalendar" SelectionMode="SingleDate"/></Border></Popup>
    <DatePicker Name="DatePicker" Visibility="Collapsed"/>
   </Grid>
   <ScrollViewer Name="BodyScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Name="ContentPanel"/></ScrollViewer>
   <Grid Name="Footer" Grid.Row="3" Margin="0,10,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Name="StatusLabel" FontSize="10" Foreground="#A0B1A7" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/><WrapPanel Name="FooterActions" Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0"><Button Name="RefreshButton" Content="刷新Excel" FontSize="10" ToolTip="只读取已保存的 Excel，保留本地未同步修改"/><Button Name="ScheduleButton" Content="排期" FontSize="10" Margin="0,0,4,0" Visibility="Collapsed"/><Button Name="NewButton" Content="＋ 新建" FontSize="10" Background="#E7F2EB" Foreground="#43765C" Margin="0,0,4,0"/><Button Name="OpenPlanButton" Content="同步并打开Excel" FontSize="10" Padding="5,5"/></WrapPanel></Grid>
   <Popup Name="TimeSlotPopup" Placement="Top" PlacementTarget="{Binding ElementName=ScheduleButton}" StaysOpen="True" AllowsTransparency="True"><Border Background="#FCFEFC" BorderBrush="#DCE9E1" BorderThickness="1" CornerRadius="12" Padding="10" MaxWidth="340"><StackPanel><DockPanel Margin="2,0,2,6"><Button Name="CloseSchedulePopup" Content="×" DockPanel.Dock="Right" Padding="5,1"/><TextBlock Name="ScheduleHint" Text="拖到时间点，为当前日期安排任务" Foreground="#547562" FontSize="11" VerticalAlignment="Center"/></DockPanel><WrapPanel Name="DaySlotPanel" Visibility="Collapsed"/><WrapPanel Name="TimeSlotPanel"/></StackPanel></Border></Popup>
  </Grid>
 </Border>
</Window>
